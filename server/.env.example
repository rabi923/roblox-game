# Hotel Hermes - Server Environment Configuration Template
# Copy this file to .env and configure your secret credentials

# Secret token shared between Roblox HttpService and server.py
HERMES_API_SECRET=HERMES_HOTEL_SECRET_TOKEN_2026

# Supabase Credentials
supabase_access_token=your_supabase_personal_access_token
project_name=hotel_hermes
supabase_database_password=your_db_password

# Server host & port
PORT=5000
HOST=0.0.0.0
